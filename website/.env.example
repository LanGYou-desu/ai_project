# LanGYou Archive — local / production environment
# Copy to .env and fill in real values. Never commit .env.

PORT=3000
HOST=127.0.0.1

# Runtime data (uploaded packages, extracted demos, works.json, auth.json)
DATA_DIR=./storage
PLAY_DIR=./storage/play
PACKAGE_DIR=./storage/packages

# Public origin used for uploaded/built-in live demos
PLAY_BASE=https://play.langyousaikyo.top

# Owner account
ADMIN_USERNAME=LanGYou
# Only used on first boot. Change it after first login in the Studio.
ADMIN_PASSWORD=replace-with-a-strong-password

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret

# Set to false only for local HTTP development
COOKIE_SECURE=true
