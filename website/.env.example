# LanGYou Archive — local / production environment
# Copy to .env and fill in real values. Never commit .env.

PORT=3000
HOST=127.0.0.1

# Runtime data (users.json, posts.json, codes.json, works.json, packages, demos)
DATA_DIR=./storage
PLAY_DIR=./storage/play
PACKAGE_DIR=./storage/packages

# Public origin used for uploaded/built-in live demos
PLAY_BASE=https://play.langyousaikyo.top

# First admin account (only used when users.json does not exist yet)
ADMIN_USERNAME=LanGYou
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret

# Set to false only for local HTTP development
COOKIE_SECURE=true

# Email verification for registration and password reset.
# Local development: console prints the 6-digit code to the terminal.
# Production: use smtp + your mail provider's SMTP authorization code.
MAIL_MODE=console
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@example.com
SMTP_PASS=
MAIL_FROM=admin@example.com
