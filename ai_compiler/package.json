{
  "name": "ai-compiler",
  "version": "1.2.0",
  "description": "AI 编译器：编辑器内容通过 API 发送给 AI 模拟运行，输出显示在编辑器内终端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "test": "node --test",
    "release": "electron-builder"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ai-compiler.app",
    "productName": "AI编译器",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "workspace-security.js",
      "public/**/*",
      "node_modules/express/**/*",
      "node_modules/dotenv/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI编译器"
    }
  }
}
